{
  "permissions": {
    "allow": [
      "Bash(bun twin.ts *)",
      "Bash(bun twin.ts)",
      "Read",
      "Glob",
      "Grep",
      "Edit(./profile/**)",
      "Edit(./notes/**)",
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(*--no-ver*)",
      "Bash(*hooksPath*)",
      "Bash(*hookspath*)",
      "Bash(*hooks/commit-msg*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun twin.ts brief",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun twin.ts guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
