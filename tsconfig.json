{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "types": ["bun"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, "skipLibCheck": true, "noEmit": true,
    "verbatimModuleSyntax": true, "allowImportingTsExtensions": true
  },
  "include": ["twin.ts", "lib", "collectors", "test", "evals"]
}
